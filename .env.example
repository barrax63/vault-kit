#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
### STANDARD CONFIGURATION (CHANGE THIS!)
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

# Port where nginx exposes the service to
NGINX_PORT=4097

# Database user password
POSTGRES_PASSWORD=password

# Replace with your real domain or IP
HOST=vault.example.com

# Admin Token (Generate using "docker exec -it <vaultwarden-container> /vaultwarden hash")
# NOTE: you need to escape all five occurrences of the dollar sign $ in the generated argon2 PHC string using two dollar signs $$
ADMIN_TOKEN=

# Your timezone
TZ=Europe/Berlin

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
### ADVANCED CONFIGURATION (DO NOT CHANGE IF NOT NEEDED)
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

# Environment setting.
ENV=prod


#################################
# --- database configuration ---
#################################
# Specifies the username for database authentication.
POSTGRES_USER=root

# Specifies the name of the database to connect to.
POSTGRES_DB=vaultwarden


#################################
# --- SMTP configuration ---
#################################

SMTP_HOST=smtp.domain.tld
SMTP_FROM=vaultwarden@domain.tld

SMTP_PORT=587
SMTP_SECURITY=starttls

SMTP_USERNAME=myusername
SMTP_PASSWORD=MyPassw0rd


#################################
# --- security & runtime ---
#################################

# Deactivate this with "false" after you have created your account so that no strangers can register
SIGNUPS_ALLOWED=true

# Make password hinsta available from the password hint page
SHOW_PASSWORD_HINT=false

# You can restrict registration to email addresses from certain domains (comma-separated)
SIGNUPS_DOMAINS_WHITELIST=
